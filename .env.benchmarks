# Nightly benchmark job build (`pnpm benchmarks:build`, scripts/benchmarks/): WCL v2 with a
# client-credentials token. For a local run without WCL credentials, build with
# VITE_WCL_API_VERSION=1 to go through WoWAnalyzer's API instead (see the README there).
VITE_WCL_API_VERSION=2
VITE_SERVER_BASE=https://wowanalyzer.com/
VITE_SENTRY_DSN=
